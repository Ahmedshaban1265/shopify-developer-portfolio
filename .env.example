# Contact form delivery (Vercel → Settings → Environment Variables).
# Without these the /api/contact endpoint returns 503 and the form tells
# visitors to email directly — it never fails silently.

# API key from https://resend.com
RESEND_API_KEY=

# Where enquiries are delivered (comma-separated)
CONTACT_TO=Abdulramanmagdy@gmail.com,anmedshaban1265@gmail.com

# A sender address on a domain verified in Resend
CONTACT_FROM=Portfolio <hello@yourdomain.com>
